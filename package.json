{
  "name": "memweave",
  "version": "0.0.0",
  "private": true,
  "description": "Long-task memory extension for native Pi",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "resources/rule.md",
    "README.md",
    "USER_GUIDE.md"
  ],
  "scripts": {
    "resources:sync": "node scripts/sync-rule.mjs",
    "resources:check": "node scripts/sync-rule.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run resources:sync && npm run typecheck",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:distribution": "node --test tests/distribution/*.test.ts",
    "test:live": "node --test tests/live/*.test.ts",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "npm run resources:check && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
