{
  "name": "memweave",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Long-task memory runtime hosted on a pinned Pi SDK",
  "type": "module",
  "bin": { "memweave": "dist/cli/index.js" },
  "exports": { ".": { "types": "./dist/pi/index.d.ts", "import": "./dist/pi/index.js" } },
  "files": ["dist/", "README.md"],
  "engines": { "node": ">=24.22.0 <25", "npm": ">=11.19.1 <12" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:live": "vitest run tests/integration/host.live.test.ts",
    "check:docs": "node scripts/check-rule-sync.mjs",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@earendil-works/pi-telemetry": "1.3.0",
    "protobufjs": "7.6.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
